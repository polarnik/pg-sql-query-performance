FROM maven:3.9.9-eclipse-temurin-17
COPY pom.xml /tmp/
COPY src /tmp/src/
WORKDIR /tmp/
# warm up ~/.m2: Kotlin compiler, jmeter-java-dsl, JDBC driver, surefire JUnit5 provider (export only, no database needed)
RUN mvn -B clean test clean -P jmeter-dsl -DisStable=1 -Dthread_count=1 -Dduration=60 -Dtps=1 -Ddsl.exportOnly=true
RUN sh -c "rm -rf /tmp/src; rm -f /tmp/pom.xml"
