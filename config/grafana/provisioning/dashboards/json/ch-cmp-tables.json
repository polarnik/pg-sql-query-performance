          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT datname, schemaname, relname, rows_a, rows_b, rows_b - rows_a AS delta, delta / nullIf(rows_a, 0) AS delta_pct, size_a, size_b, size_b - size_a AS size_delta FROM (SELECT datname, schemaname, relname, anyIf(rows, env = ${env_a:singlequote}) AS rows_a, anyIf(rows, env = ${env_b:singlequote}) AS rows_b, anyIf(size, env = ${env_a:singlequote}) AS size_a, anyIf(size, env = ${env_b:singlequote}) AS size_b, countIf(env = ${env_a:singlequote}) AS n_a, countIf(env = ${env_b:singlequote}) AS n_b FROM (SELECT datname, schemaname, relname, env, c_rows AS rows, c_size AS size FROM (SELECT datname, schemaname, relname, env, argMax(n_live_tup, time) AS c_rows, argMax(total_bytes, time) AS c_size FROM pg_monitoring.pg_table_stat WHERE $__timeFilter(time) AND env IN (${env_a:singlequote}, ${env_b:singlequote}) AND db_instance = ${db_instance:singlequote} AND $__conditionalAll(datname IN (${datname:singlequote}), $datname) GROUP BY datname, schemaname, relname, env)) GROUP BY datname, schemaname, relname) WHERE n_a > 0 AND n_b > 0 ORDER BY abs(delta) DESC",
          "refId": "A"
        }
      ],
      "title": "Row count differences",
