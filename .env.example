# Telegraf settings for one monitored PostgreSQL instance.
# Copy to .env.db1 (.env.db2, ...) and put real values there; .env.db* files are gitignored.
# Load order per telegraf service: .env.example -> config/telegraf/env/dbN.env -> .env.dbN (last wins).

# Instance name, becomes the `db_instance` tag on every metric (overridden per service in config/telegraf/env/dbN.env)
PG_INSTANCE=demo-db1
# Environment name, becomes the `env` tag
PG_ENV=local
# Maintenance DB (where pg_stat_statements is created): cluster-wide metrics.
# Monitoring user needs only pg_monitor + CONNECT. For RDS use sslmode=require.
# statement_timeout protects the monitored DB from slow monitoring queries.
PG_DSN=postgres://telegraf_monitoring_user:pass@sql_monitor_postgres:5432/postgres?sslmode=disable&application_name=telegraf&statement_timeout=5000
# Application DB: per-database table / index statistics.
PG_APP_DSN=postgres://telegraf_monitoring_user:pass@sql_monitor_postgres:5432/demo?sslmode=disable&application_name=telegraf&statement_timeout=5000
# InfluxDB database for all new measurements (tag db_and_stand)
INFLUX_DB_MONITORING=pg_monitoring
# InfluxDB databases of the classic boards pgActivity/pgquery/pgstat (config/telegraf/telegraf.d/cluster_classic_boards.conf)
INFLUX_DB_STATEMENTS=telegraf_pg_demo
INFLUX_DB_ACTIVITY=telegraf_pg_activity_demo

# ClickHouse (second storage of the pg_monitoring measurements, Telegraf outputs.sql dual write).
# Local-stack defaults only: put real passwords into git-ignored .env.dbN (Telegraf) / .env.clickhouse (ClickHouse).
# Host of the ClickHouse service (native protocol, port 9000)
CH_HOST=clickhouse
# Admin: full access incl. access management (replaces the ClickHouse `default` user)
CH_ADMIN_USER=admin
CH_ADMIN_PASSWORD=admin
# Telegraf: INSERT, SELECT on pg_monitoring.* (async inserts)
CH_WRITER_USER=writer
CH_WRITER_PASSWORD=writer
# Grafana: SELECT on pg_monitoring.* (readonly=2, time / memory / result rows limits)
CH_READER_USER=reader
CH_READER_PASSWORD=reader
