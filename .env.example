# Telegraf settings: one Telegraf monitors all PostgreSQL instances listed in PG_INSTANCES.
# Copy to .env.dbs and put real values there; .env.* files (except this one) are gitignored.
# Load order of the telegraf service: .env.example -> .env.dbs (last wins).

# Ids of the monitored instances, comma separated (letters, digits, _). For every id <ID> set:
#   <ID>_INSTANCE - instance name, becomes the `db_instance`, `host` and `server` tags of its metrics
#   <ID>_DSN      - maintenance DB (where pg_stat_statements is created): cluster-wide metrics
#   <ID>_APP_DSN  - application DB: per-database table / index statistics
#   <ID>_ENV      - optional, environment name of this instance (`env` tag), default PG_ENV
# New instance: add its id to PG_INSTANCES and its three <ID>_* variables.
# Monitoring user needs only pg_monitor + CONNECT. For RDS use sslmode=require.
# statement_timeout protects the monitored DB from slow monitoring queries.
PG_INSTANCES=DB1,DB2,DB3,DB4

DB1_INSTANCE=frontDB
DB1_DSN=postgres://telegraf_monitoring_user:pass@sql_monitor_postgres:5432/postgres?sslmode=disable&application_name=telegraf&statement_timeout=5000
DB1_APP_DSN=postgres://telegraf_monitoring_user:pass@sql_monitor_postgres:5432/demo?sslmode=disable&application_name=telegraf&statement_timeout=5000
DB1_ENV=perf

DB2_INSTANCE=backDB
DB2_DSN=postgres://telegraf_monitoring_user:pass@sql_monitor_postgres:5432/postgres?sslmode=disable&application_name=telegraf&statement_timeout=5000
DB2_APP_DSN=postgres://telegraf_monitoring_user:pass@sql_monitor_postgres:5432/demo?sslmode=disable&application_name=telegraf&statement_timeout=5000
DB2_ENV=perf

DB3_INSTANCE=frontDB
DB3_DSN=postgres://telegraf_monitoring_user:pass@sql_monitor_postgres:5432/postgres?sslmode=disable&application_name=telegraf&statement_timeout=5000
DB3_APP_DSN=postgres://telegraf_monitoring_user:pass@sql_monitor_postgres:5432/demo?sslmode=disable&application_name=telegraf&statement_timeout=5000
DB3_ENV=prod

DB4_INSTANCE=backDB
DB4_DSN=postgres://telegraf_monitoring_user:pass@sql_monitor_postgres:5432/postgres?sslmode=disable&application_name=telegraf&statement_timeout=5000
DB4_APP_DSN=postgres://telegraf_monitoring_user:pass@sql_monitor_postgres:5432/demo?sslmode=disable&application_name=telegraf&statement_timeout=5000
DB4_ENV=prod

# e.g. a stage instance next to the local ones
# DB4_ENV=stage

# Default environment name (`env` tag) of the instances without <ID>_ENV
PG_ENV=local
# InfluxDB database for all new measurements (tag db_and_stand)
INFLUX_DB_MONITORING=pg_monitoring
# InfluxDB databases of the classic boards pgActivity/pgquery/pgstat (config/telegraf/inputs.d/cluster_classic_boards.conf)
INFLUX_DB_STATEMENTS=telegraf_pg_demo
INFLUX_DB_ACTIVITY=telegraf_pg_activity_demo

# ClickHouse (second storage of the pg_monitoring measurements, Telegraf outputs.sql dual write).
# Local-stack defaults only: put real passwords into git-ignored .env.dbs (Telegraf) / .env.clickhouse (ClickHouse).
# Host of the ClickHouse service (native protocol, port 9000)
CH_HOST=clickhouse
# Admin: full access incl. access management (replaces the ClickHouse `default` user)
CH_ADMIN_USER=admin
CH_ADMIN_PASSWORD=admin
# Telegraf: INSERT, SELECT on pg_monitoring.* (async inserts)
CH_WRITER_USER=writer
CH_WRITER_PASSWORD=writer
# Grafana: SELECT on pg_monitoring.* (readonly=2, time / memory / result rows limits)
CH_READER_USER=reader
CH_READER_PASSWORD=reader
